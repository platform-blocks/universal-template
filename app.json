{
  "expo": {
    "name": "plocks Universal",
    "slug": "plocks-universal",
    "version": "0.1.0",
    "scheme": "plocksuniversal",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-audio"
    ]
  }
}